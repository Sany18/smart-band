<template>
  <div class="page">
    <text class="title">GB Relay</text>
    <text class="status">{{ status }}</text>
    <image class="tile" if="{{imageSrc}}" src="{{imageSrc}}"></image>
    <text class="message">{{ lastMessage }}</text>
    <text class="button" onclick="sendPing">SEND PING</text>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #000000;
    flex: 1;
  }
  .title {
    color: #888888;
    font-size: 28px;
    margin-bottom: 16px;
  }
  .status {
    color: #1e90ff;
    font-size: 22px;
    margin-bottom: 20px;
  }
  .message {
    color: #ffffff;
    font-size: 22px;
    margin-bottom: 30px;
    text-align: center;
    lines: 6;
  }
  .tile {
    width: 64px;
    height: 64px;
    margin-bottom: 16px;
  }
  .button {
    color: #1e90ff;
    font-size: 26px;
    border-width: 2px;
    border-color: #1e90ff;
    padding: 12px 24px;
  }
</style>

<script>
  import interconnect from '@system.interconnect'
  import file from '@system.file'

  const BASE64_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

  function base64ToArrayBuffer(base64) {
    const clean = base64.replace(/[^A-Za-z0-9+/]/g, '')
    const bytes = []
    let buffer = 0
    let bits = 0
    for (let i = 0; i < clean.length; i++) {
      buffer = (buffer << 6) | BASE64_CHARS.indexOf(clean[i])
      bits += 6
      if (bits >= 8) {
        bits -= 8
        bytes.push((buffer >> bits) & 0xff)
      }
    }
    return new Uint8Array(bytes)
  }

  export default {
    private: {
      status: 'starting...',
      lastMessage: '(no message yet)',
      imageSrc: '',
      connect: interconnect.instance()
    },
    onShow() {
      this.refreshStatus()
      this.connect.onmessage = (data) => {
        this.refreshStatus()
        if (typeof data.data === 'string' && data.data.indexOf('IMG:') === 0) {
          this.handleImageMessage(data.data.substring(4))
        } else {
          this.lastMessage = data.data
        }
      }
      this.connect.onclose = () => {
        this.status = 'closed'
      }
    },
    handleImageMessage(base64) {
      this.lastMessage = 'decoding image, ' + base64.length + ' b64 chars'
      try {
        const buffer = base64ToArrayBuffer(base64)
        file.writeArrayBuffer({
          uri: 'internal://files/tile.png',
          buffer: buffer,
          success: () => {
            this.lastMessage = 'image written, ' + buffer.byteLength + ' bytes'
            this.imageSrc = 'internal://files/tile.png'
          },
          fail: (data, code) => {
            this.lastMessage = 'file write failed ' + code + ': ' + JSON.stringify(data)
          }
        })
      } catch (e) {
        this.lastMessage = 'exception: ' + e.message
      }
    },
    refreshStatus() {
      this.status = this.connect.getApkStatus()
    },
    sendPing() {
      this.connect.send({
        data: { data: 'ping from watch, count=' + Date.now() },
        success: () => {
          this.status = 'sent ok'
        },
        fail: (data) => {
          this.status = 'send failed: ' + JSON.stringify(data)
        }
      })
    }
  }
</script>
